# Copy to .env.local and adjust.

# true  = use the in-browser mock backend (no ASP.NET Core API needed)
# false = call the real API under /api (proxied by Vite in dev)
VITE_USE_MOCK_API=true

# Base URL prefix for API calls (keep "/api" when using the Vite proxy)
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api when the mock is off
VITE_API_PROXY_TARGET=https://localhost:5001
