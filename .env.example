# Copy to .env.local and adjust.

# true  = use the in-browser mock backend (no ASP.NET Core API needed)
# false = call the real APIs under /api (proxied by Vite in dev)
VITE_USE_MOCK_API=true

# true = sign in through the real Identity API (run it first) while the rest still uses the mock.
# Demo users then come from PostgreSQL: DN10110, PS10210, SR10310, HA10120 (password demo123).
VITE_USE_REAL_AUTH=false

# Sign out after this many minutes with no mouse or keyboard activity (a warning appears 60 seconds before).
# 0 = never. Later this moves to the Admin module as a per-hospital setting.
VITE_IDLE_TIMEOUT_MINUTES=15

# Base URL prefix for API calls (keep "/api" when using the Vite proxy)
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards requests when the real APIs are used
VITE_IDENTITY_API_TARGET=http://localhost:5077
VITE_API_PROXY_TARGET=http://localhost:5041
